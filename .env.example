# =====================================================================
#  COPY THIS FILE: cp .env.example .env
#  Then fill in your secrets below. chmod 600 .env (Linux/Mac only)
# =====================================================================

TIMEZONE=Asia/Kolkata

# ─────────────────────────────────────────────────────────────────────
# ALERTS PROVIDER — choose ONE
# ─────────────────────────────────────────────────────────────────────

# ✅ OPTION A: Telegram Bot (BEST — 100% FREE · unlimited · forever · easy)
#   Setup (2 min):
#   1. Open Telegram → search @BotFather → send: /newbot
#   2. Give your bot a name & username → copy the TOKEN
#   3. Open your new bot → send /start
#   4. Visit: https://api.telegram.org/bot<TOKEN>/getUpdates
#      Find "chat":{"id":XXXXXXXXX} — that is your CHAT_ID
WHATSAPP_PROVIDER=telegram
TELEGRAM_BOT_TOKEN=                # e.g. 7123456789:AAHdqTBr4xxxxxxxxxxxx
TELEGRAM_CHAT_ID=                  # e.g. 123456789

# OPTION B: Whapi.Cloud (free 150 msg trial · WhatsApp groups)
#   Setup: https://whapi.cloud → Sign Up → Create Channel → Scan QR
#   Personal: WHATSAPP_GROUP_ID=91XXXXXXXXXX@s.whatsapp.net
# WHATSAPP_PROVIDER=whapi
# WHATSAPP_TOKEN=
# WHATSAPP_GROUP_ID=

# OPTION C: CallMeBot (free · unlimited · personal WhatsApp only)
#   Note: Number +34 644 60 77 73 may not be available in all regions
#   Setup: https://www.callmebot.com/blog/free-api-whatsapp-messages/
# WHATSAPP_PROVIDER=callmebot
# CALLMEBOT_PHONE=919876543210
# CALLMEBOT_APIKEY=

# OPTION D: Wassenger (paid)
# WHATSAPP_PROVIDER=wassenger
# WHATSAPP_TOKEN=
# WHATSAPP_GROUP_ID=

# ---------------------------------------------------------------------
# DISCORD HIDDEN CLIENT LEADS (100% FREE · client_alert.py)
# Discord Developer Portal se free Bot create karo
# Channels: Comma-separated channel IDs (e.g. 1122334455,guild_id:channel_id)
# ---------------------------------------------------------------------
DISCORD_TOKEN=                      # Discord Bot token (e.g. MTAxND...)
DISCORD_CHANNELS=                   # Comma-separated channel IDs to monitor
DISCORD_HOURS=3                     # Look back window in hours (default 3h)

# ---------------------------------------------------------------------
# GOOGLE PLACES CRM  prospect_app.py + client_alert.py
# Free: $200/month Google credit (enable billing, set quota to $0 cap)
# Enable: Places API (New) + optionally Maps JavaScript API
# ---------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=             # server-side key, restrict to Places API (New)
GOOGLE_MAPS_BROWSER_KEY=           # browser key, restrict to Maps JavaScript API + your domain
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=                # choose a strong password
PORT=8000

# Multi-city prospect discovery (semicolon-separated cities)
PROSPECT_CITIES=Agra, Uttar Pradesh, India;Mathura, Uttar Pradesh, India;Noida, Uttar Pradesh, India;Gurugram, Haryana, India;Jaipur, Rajasthan, India;Austin, Texas, USA;Dallas, Texas, USA

# Business categories to prospect (pipe: label|Segment, semicolons between entries)
PROSPECT_CATEGORIES=garment stores and boutiques|Retail;online stores and ecommerce brands|Retail;electronics stores|Retail;furniture stores and interior studios|Retail;jewellery stores|Retail;restaurants and cafes|Food;salons and spas|Beauty;dentists and clinics|Health;hotels and guest houses|Hospitality;gyms and fitness studios|Fitness;coaching centres|Education;manufacturers and exporters|B2B

MAX_PLACE_QUERIES_PER_RUN=12      # rotate city/category pairs to control API cost
PLACES_PAGE_SIZE=12
MIN_PROSPECT_REVIEWS=15
MIN_PROSPECT_SCORE=65
MAX_PROSPECT_ALERTS=6
PROSPECT_ID_RETENTION_DAYS=180
MAX_TRACKED_HYDRATIONS=20
ENABLE_WEBSITE_AUDIT=0             # 1 = one respectful homepage check per selected site
MAX_WEBSITE_AUDITS=6

# ---------------------------------------------------------------------
# JOB ALERTS
# ---------------------------------------------------------------------
HOURS_OLD=36
MAX_JOBS=20
LOCAL_HOURS_OLD=168
MAX_LOCAL_JOBS=10

# Append extra official ATS boards: kind|Company|token (comma-separated)
# ATS_BOARDS=greenhouse|Company A|token,lever|Company B|token

# ---------------------------------------------------------------------
# CLIENT / FREELANCE LEADS
# ---------------------------------------------------------------------
CLIENT_HOURS_OLD=48
MAX_CLIENT_LEADS=12
MIN_FIXED_USD=40
MIN_HOURLY_USD=5
PORTFOLIO_URL=                     # your portfolio URL, shown in pitches
